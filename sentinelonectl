cmd_logs() {
  local target="${1:-manager}"

  case "$target" in
    agent)
      box "Logs de l'agent SentinelOne"
      check_s1ctl || return 1
      sudo "$S1CTL" log
      ;;
    service)
      box "Logs systemd (${SERVICE_NAME})"
      log_message "INFO" "Journalctl $SERVICE_NAME"
      journalctl -u "$SERVICE_NAME" -n 50 --no-pager 2>/dev/null || \
        warn "Pas de logs systemd disponibles."
      ;;
    manager)
      box "Logs du script S1 Manager"
      if [[ -f "$LOG_FILE" ]]; then
        echo -e "${DIM}Fichier : $LOG_FILE${RESET}"
        sep
        tail -n 50 "$LOG_FILE"
      else
        warn "Aucun fichier de log trouvé à $LOG_FILE"
      fi
      ;;
    *)
      err "Cible inconnue : '${target}'"
      echo -e "  Disponibles : ${CYAN}agent  service  manager${RESET}"
      return 1
      ;;
  esac
}

# ─── Commandes : Service systemd ───────────────────────────────────────────────

cmd_service() {
  local sub="${1:-}"; shift || true

  case "$sub" in
    start)
      info "Démarrage du service ${SERVICE_NAME}..."
      log_message "INFO" "Service start"
      sudo systemctl start "$SERVICE_NAME"
      local rc=$?
      (( rc == 0 )) && ok "Service démarré." || err "Échec (rc=$rc)."
      return $rc
      ;;
    stop)
      info "Arrêt du service ${SERVICE_NAME}..."
      log_message "INFO" "Service stop"
      sudo systemctl stop "$SERVICE_NAME"
      local rc=$?
      (( rc == 0 )) && ok "Service arrêté." || err "Échec (rc=$rc)."
      return $rc
      ;;
    restart)
      info "Redémarrage du service ${SERVICE_NAME}..."
      log_message "INFO" "Service restart"
      sudo systemctl restart "$SERVICE_NAME"
      local rc=$?
      (( rc == 0 )) && ok "Service redémarré." || err "Échec (rc=$rc)."
      return $rc
      ;;
    status)
      log_message "INFO" "Service status"
      systemctl status "$SERVICE_NAME" --no-pager
      return $?
      ;;
    enable)
      info "Activation du démarrage automatique..."
      log_message "INFO" "Service enable"
      sudo systemctl enable "$SERVICE_NAME"
      local rc=$?
      (( rc == 0 )) && ok "Service activé au démarrage." || err "Échec (rc=$rc)."
      return $rc
      ;;
    disable)
      info "Désactivation du démarrage automatique..."
      log_message "INFO" "Service disable"
      sudo systemctl disable "$SERVICE_NAME"
      local rc=$?
      (( rc == 0 )) && ok "Service désactivé." || err "Échec (rc=$rc)."
      return $rc
      ;;
    reload)
      info "Rechargement du service ${SERVICE_NAME}..."
      log_message "INFO" "Service reload"
      sudo systemctl reload "$SERVICE_NAME"
      local rc=$?
      (( rc == 0 )) && ok "Service rechargé." || err "Échec (rc=$rc)."
      return $rc
      ;;
    *)
      err "Sous-commande inconnue : '${sub}'"
      echo -e "  Disponibles : ${CYAN}start  stop  restart  status  enable  disable  reload${RESET}"
      return 1
      ;;
  esac
}

# ─── Commandes : Diagnostic ────────────────────────────────────────────────────

cmd_status() {
  box "Statut Rapide SentinelOne"

  section "Service systemd (${SERVICE_NAME})"
  echo
  systemctl status "$SERVICE_NAME" --no-pager 2>/dev/null || \
    warn "Service $SERVICE_NAME introuvable ou inactif."

  echo
  section "Agent SentinelOne"
  echo
  if check_s1ctl 2>/dev/null; then
    sudo "$S1CTL" control status
  fi
}

cmd_health() {
  box "Health Check Complet"
  log_message "INFO" "Health check"

  local overall="OK"

  section "Informations système"
  echo -e "   OS          : ${GREEN}${OS_NAME:-inconnu}${OS_VERSION:+ $OS_VERSION}${RESET}"
  echo -e "   Famille pkg : ${GREEN}${PKG_FAMILY:-inconnu}${RESET} (${PKG_MANAGER:-?})"
  echo -e "   Utilisateur : ${GREEN}$(whoami)${RESET}"

  echo
  section "Binaire sentinelctl"
  if [[ -x "$S1CTL" ]]; then
    echo -e "   ${GREEN}[OK]${RESET}      Disponible : $S1CTL"
  else
    echo -e "   ${RED}[ERREUR]${RESET}  Introuvable : $S1CTL"
    overall="WARN"
  fi

  echo
  section "Service systemd (${SERVICE_NAME})"
  if systemctl is-enabled "$SERVICE_NAME" &>/dev/null; then
    echo -e "   ${GREEN}[OK]${RESET}      Auto-démarrage : ACTIVÉ"
  else
    echo -e "   ${YELLOW}[WARN]${RESET}    Auto-démarrage : DÉSACTIVÉ"
    overall="WARN"
  fi
  if systemctl is-active "$SERVICE_NAME" &>/dev/null; then
    echo -e "   ${GREEN}[OK]${RESET}      État : EN COURS D'EXÉCUTION"
  else
    echo -e "   ${RED}[ERREUR]${RESET}  État : ARRÊTÉ"
    overall="WARN"
  fi

  if [[ -x "$S1CTL" ]]; then
    echo
    section "Statut de l'agent"
    sep
    sudo "$S1CTL" control status 2>&1 || { echo -e "${RED}Erreur commande${RESET}"; overall="WARN"; }

    echo
    section "Version de l'agent"
    sep
    sudo "$S1CTL" version 2>&1 || { echo -e "${RED}Erreur commande${RESET}"; overall="WARN"; }
  fi

  echo
  section "Logs systemd récents"
  sep
  journalctl -u "$SERVICE_NAME" -n 15 --no-pager 2>/dev/null || \
    echo -e "${YELLOW}Pas de logs systemd disponibles.${RESET}"

  echo
  echo -e "${DIM}═════════════════════════════════════════════════════${RESET}"
  if [[ "$overall" == "OK" ]]; then
    ok "Health Check : TOUS LES TESTS RÉUSSIS"
    log_message "INFO" "Health check OK"
    return 0
  else
    warn "Health Check : AVERTISSEMENTS DÉTECTÉS"
    log_message "WARN" "Health check avec avertissements"
    return 1
  fi
}

# ─── Commandes : Menu / Raw ────────────────────────────────────────────────────

cmd_menu() {
  local deploy_script=""
  for candidate in \
    "$SCRIPT_DIR/deploy-s1.sh" \
    "/usr/local/bin/deploy-s1.sh" \
    "$(dirname "$(command -v sentinelonectl 2>/dev/null || echo "")")/deploy-s1.sh"; do
    if [[ -f "$candidate" ]]; then
      deploy_script="$candidate"
      break
    fi
  done

  if [[ -z "$deploy_script" ]]; then
    err "deploy-s1.sh introuvable."
    err "Assurez-vous qu'il est dans le même répertoire que sentinelonectl ou dans /usr/local/bin."
    return 1
  fi

  bash "$deploy_script"
}

cmd_raw() {
  check_s1ctl || return 1
  if (( $# == 0 )); then
    err "Usage : sentinelonectl raw <args sentinelctl...>"
    err "Exemple : sentinelonectl raw control status"
    return 1
  fi
  log_message "INFO" "Raw sentinelctl $*"
  sudo "$S1CTL" "$@"
  return $?
}

cmd_version() {
  check_s1ctl || return 1
  sudo "$S1CTL" version
}

# ─── Main ──────────────────────────────────────────────────────────────────────

detect_os

if (( $# == 0 )); then
  print_help
  exit 0
fi

COMMAND="$1"; shift

case "$COMMAND" in
  install)            cmd_install "$@" ;;
  uninstall|remove)   cmd_uninstall "$@" ;;
  upgrade)            cmd_agent upgrade "$@" ;;
  token)              cmd_token "$@" ;;
  agent)              cmd_agent "$@" ;;
  scan)               cmd_scan "$@" ;;
  policy)             cmd_policy "$@" ;;
  quarantine)         cmd_quarantine "$@" ;;
  firewall|fw)        cmd_firewall "$@" ;;
  engines)            cmd_engines "$@" ;;
  asset)              cmd_asset "$@" ;;
  management|mgmt)    cmd_management "$@" ;;
  log)                cmd_log "$@" ;;
  logs)               cmd_logs "$@" ;;
  service|svc)        cmd_service "$@" ;;
  status)             cmd_status "$@" ;;
  health)             cmd_health "$@" ;;
  version)            cmd_version "$@" ;;
  menu)               cmd_menu "$@" ;;
  raw)                cmd_raw "$@" ;;
  help|--help|-h)     print_help ;;
  *)
    err "Commande inconnue : '$COMMAND'"
    echo
    echo -e "Lancez ${CYAN}sentinelonectl help${RESET} pour voir toutes les commandes disponibles."
    exit 1
    ;;
esac
