# ─── Commandes : Installation ──────────────────────────────────────────────────

cmd_install() {
  local pkg_source="${1:-}"
  if [[ -z "$pkg_source" ]]; then
    err "Usage : sentinelonectl install <chemin|url>"
    return 1
  fi

  box "Installation de l'agent SentinelOne"
  need_root

  local ext=".pkg"
  [[ "$PKG_FAMILY" == "rpm" ]] && ext=".rpm"
  [[ "$PKG_FAMILY" == "deb" ]] && ext=".deb"

  local pkg_path=""

  if [[ "$pkg_source" =~ ^https?:// ]]; then
    TEMP_FILE="$(mktemp "/tmp/sentinelone-agent-XXXXXX${ext}")"
    info "Téléchargement depuis : $pkg_source"

    local dl_ok=0
    if command -v curl &>/dev/null; then
      curl -fL --retry 3 --connect-timeout 15 -o "$TEMP_FILE" "$pkg_source" && dl_ok=1
    elif command -v wget &>/dev/null; then
      wget -q --tries=3 --timeout=15 -O "$TEMP_FILE" "$pkg_source" && dl_ok=1
    else
      err "curl ou wget requis pour le téléchargement."
      return 1
    fi

    if (( dl_ok == 0 )); then
      err "Échec du téléchargement."
      return 1
    fi
    pkg_path="$TEMP_FILE"
  else
    if [[ ! -f "$pkg_source" ]]; then
      err "Fichier introuvable : $pkg_source"
      return 1
    fi
    pkg_path="$pkg_source"
  fi

  info "Installation via ${PKG_MANAGER:-?} : $pkg_path"
  log_message "INFO" "Installation de l'agent depuis $pkg_source (PKG_MANAGER=$PKG_MANAGER)"

  local rc=0
  case "$PKG_MANAGER" in
    dnf)     sudo dnf install -y "$pkg_path" ; rc=$? ;;
    yum)     sudo yum install -y "$pkg_path" ; rc=$? ;;
    rpm)     sudo rpm -Uvh "$pkg_path" ; rc=$? ;;
    apt)     sudo apt install -y "$pkg_path" ; rc=$? ;;
    apt-get) sudo apt-get install -y "$pkg_path" ; rc=$? ;;
    dpkg)    sudo dpkg -i "$pkg_path" ; rc=$? ;;
    *)
      err "Aucun gestionnaire de paquets détecté."
      return 1
      ;;
  esac

  if (( rc == 0 )); then
    ok "Agent installé avec succès."
    log_message "INFO" "Installation réussie."
    echo
    if [[ -x "$S1CTL" ]]; then
      info "Démarrage de l'agent..."
      sudo "$S1CTL" control start && ok "Agent démarré." || warn "Démarrage automatique échoué — lancez : sentinelonectl agent start"
    fi
  else
    err "Échec de l'installation (rc=$rc)."
    log_message "ERROR" "Échec installation (rc=$rc)"
    return $rc
  fi
}

cmd_uninstall() {
  box "Désinstallation de l'agent SentinelOne"
  warn "Cette action va supprimer l'agent SentinelOne du système."
  read -rp "Confirmer la désinstallation (y/N) : " confirm
  [[ "$confirm" != "y" && "$confirm" != "Y" ]] && { info "Annulé."; return 0; }

  log_message "INFO" "Désinstallation de l'agent ($AGENT_PACKAGE)"

  local rc=0
  case "$PKG_MANAGER" in
    dnf)     sudo dnf remove -y "$AGENT_PACKAGE" ; rc=$? ;;
    yum)     sudo yum remove -y "$AGENT_PACKAGE" ; rc=$? ;;
    rpm)     sudo rpm -e "$AGENT_PACKAGE" ; rc=$? ;;
    apt)     sudo apt remove --purge -y "$AGENT_PACKAGE" ; rc=$? ;;
    apt-get) sudo apt-get remove --purge -y "$AGENT_PACKAGE" ; rc=$? ;;
    dpkg)    sudo dpkg -P "$AGENT_PACKAGE" ; rc=$? ;;
    *)
      err "Aucun gestionnaire de paquets détecté."
      return 1
      ;;
  esac

  if (( rc == 0 )); then
    ok "Agent désinstallé."
  else
    err "Échec de la désinstallation (rc=$rc)."
  fi
  log_message "INFO" "Désinstallation terminée (rc=$rc)"
  return $rc
}

# ─── Commandes : Token ─────────────────────────────────────────────────────────

cmd_token() {
  local sub="${1:-}"; shift || true

  case "$sub" in
    set)
      local token="${1:-}"
      if [[ -z "$token" ]]; then
        err "Usage : sentinelonectl token set <token>"
        return 1
      fi
      box "Définition du token de management"
      check_s1ctl || return 1
      log_message "INFO" "Définition du token de management"
      sudo "$S1CTL" management token set "$token"
      local rc=$?
      (( rc == 0 )) && ok "Token défini avec succès." || err "Échec (rc=$rc)."
      return $rc
      ;;
    get)
      check_s1ctl || return 1
      sudo "$S1CTL" management token get
      ;;
    *)
      err "Sous-commande inconnue : '${sub}'"
      echo -e "  Disponibles : ${CYAN}set <token>${RESET}  ${CYAN}get${RESET}"
      return 1
      ;;
  esac
}

