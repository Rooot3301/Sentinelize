#!/bin/bash
#
# sentinelonectl - SentinelOne Agent CLI Manager
# Outil CLI installable système pour gérer l'agent SentinelOne
# Author: Root3301
# Version: 3.0
#
# Installation : sudo ./deploy-s1.sh --install-tools
#             ou : sudo cp sentinelonectl /usr/local/bin/ && sudo chmod +x /usr/local/bin/sentinelonectl

set -o pipefail

# ─── Configuration ─────────────────────────────────────────────────────────────

S1CTL_DEFAULT="/opt/sentinelone/bin/sentinelctl"
SERVICE_NAME_DEFAULT="sentinelone"
AGENT_PACKAGE_DEFAULT="sentinelone-agent"
LOG_FILE_DEFAULT="/var/log/s1-manager.log"
LOG_LEVEL_DEFAULT="INFO"

# Recherche du .env dans plusieurs emplacements
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

for _env_candidate in \
  "$SCRIPT_DIR/.env" \
  "/etc/sentinelize/.env" \
  "/usr/local/etc/sentinelize/.env"; do
  if [[ -f "$_env_candidate" ]]; then
    # shellcheck disable=SC1090
    source "$_env_candidate"
    break
  fi
done

S1CTL="${S1CTL:-$S1CTL_DEFAULT}"
SERVICE_NAME="${SERVICE_NAME:-$SERVICE_NAME_DEFAULT}"
AGENT_PACKAGE="${AGENT_PACKAGE:-$AGENT_PACKAGE_DEFAULT}"
LOG_FILE="${LOG_FILE:-$LOG_FILE_DEFAULT}"
LOG_LEVEL="${LOG_LEVEL:-$LOG_LEVEL_DEFAULT}"

# Fichier temporaire global
TEMP_FILE=""
trap 'if [[ -n "$TEMP_FILE" && -f "$TEMP_FILE" ]]; then rm -f "$TEMP_FILE"; fi' EXIT INT TERM

# ─── Couleurs ──────────────────────────────────────────────────────────────────

GREEN="\e[32m"
RED="\e[31m"
CYAN="\e[36m"
YELLOW="\e[33m"
MAGENTA="\e[35m"
BLUE="\e[34m"
BOLD="\e[1m"
DIM="\e[2m"
RESET="\e[0m"

# ─── Détection OS ──────────────────────────────────────────────────────────────

PKG_FAMILY=""
PKG_MANAGER=""
OS_NAME=""
OS_VERSION=""

detect_os() {
  if [[ -f /etc/os-release ]]; then
    # shellcheck disable=SC1091
    source /etc/os-release 2>/dev/null || true
    OS_NAME="${NAME:-Unknown}"
    OS_VERSION="${VERSION_ID:-}"
    local id_like="${ID_LIKE:-}"
    local id="${ID:-}"

    if echo "$id $id_like" | grep -qiE "rhel|centos|fedora|suse|sles|alma|rocky|oracle"; then
      PKG_FAMILY="rpm"
    elif echo "$id $id_like" | grep -qiE "debian|ubuntu|mint|kali|raspbian"; then
      PKG_FAMILY="deb"
    fi
  fi

  if [[ -z "$PKG_FAMILY" ]]; then
    command -v dpkg &>/dev/null && PKG_FAMILY="deb"
    command -v rpm  &>/dev/null && [[ -z "$PKG_FAMILY" ]] && PKG_FAMILY="rpm"
  fi

  if [[ "$PKG_FAMILY" == "rpm" ]]; then
    if command -v dnf &>/dev/null; then
      PKG_MANAGER="dnf"
    elif command -v yum &>/dev/null; then
      PKG_MANAGER="yum"
    else
      PKG_MANAGER="rpm"
    fi
  elif [[ "$PKG_FAMILY" == "deb" ]]; then
    if command -v apt &>/dev/null; then
      PKG_MANAGER="apt"
    elif command -v apt-get &>/dev/null; then
      PKG_MANAGER="apt-get"
    else
      PKG_MANAGER="dpkg"
    fi
  fi
}

# ─── Logging ───────────────────────────────────────────────────────────────────

log_message() {
  local level="$1"; shift
  local msg="$*"

  case "$LOG_LEVEL" in
    ERROR) [[ "$level" == "ERROR" ]] || return 0 ;;
    WARN)  [[ "$level" =~ ^(ERROR|WARN)$ ]] || return 0 ;;
    INFO)  [[ "$level" =~ ^(ERROR|WARN|INFO)$ ]] || return 0 ;;
    DEBUG) ;;
    *) ;;
  esac

  local ts
  ts="$(date '+%Y-%m-%d %H:%M:%S')"
  mkdir -p "$(dirname "$LOG_FILE")" 2>/dev/null || true
  echo "[$ts] [sentinelonectl] [$level] $msg" >> "$LOG_FILE" 2>/dev/null || true
}

# ─── Fonctions d'affichage ─────────────────────────────────────────────────────

ok()   { echo -e "${GREEN}${BOLD}[OK]${RESET} ${GREEN}$*${RESET}"; }
err()  { echo -e "${RED}${BOLD}[ERREUR]${RESET} ${RED}$*${RESET}" >&2; }
warn() { echo -e "${YELLOW}${BOLD}[WARN]${RESET} ${YELLOW}$*${RESET}"; }
info() { echo -e "${CYAN}▸${RESET} $*"; }
sep()  { echo -e "${DIM}─────────────────────────────────────────────────────${RESET}"; }

box() {
  echo -e "${BOLD}${CYAN}┌─────────────────────────────────────────────────────┐${RESET}"
  echo -e "${BOLD}${CYAN}│${RESET}  ${BOLD}$*${RESET}"
  echo -e "${BOLD}${CYAN}└─────────────────────────────────────────────────────┘${RESET}"
  echo
}

section() {
  echo -e "${BOLD}${BLUE}➤ $*${RESET}"
}

# ─── Vérifications ─────────────────────────────────────────────────────────────

check_s1ctl() {
  if [[ ! -x "$S1CTL" ]]; then
    err "sentinelctl introuvable ou non exécutable : $S1CTL"
    err "Vérifiez que l'agent SentinelOne est installé."
    return 1
  fi
}

need_root() {
  if [[ $EUID -ne 0 ]]; then
    warn "Cette commande nécessite des privilèges root (sudo sera utilisé)."
  fi
}

