      ;;
    stop)
      box "Arrêt de l'agent"
      log_message "INFO" "Agent stop"
      sudo "$S1CTL" control stop
      local rc=$?
      (( rc == 0 )) && ok "Agent arrêté." || err "Échec de l'arrêt (rc=$rc)."
      return $rc
      ;;
    status)
      box "Statut de l'agent"
      log_message "INFO" "Agent status"
      sudo "$S1CTL" control status
      return $?
      ;;
    version)
      box "Version de l'agent"
      log_message "INFO" "Agent version"
      sudo "$S1CTL" version
      return $?
      ;;
    detect)
      box "Détection de l'agent"
      log_message "INFO" "Agent detect"
      sudo "$S1CTL" detector
      return $?
      ;;
    upgrade)
      box "Mise à jour de l'agent"
      log_message "INFO" "Agent upgrade"
      sudo "$S1CTL" control upgrade
      local rc=$?
      (( rc == 0 )) && ok "Agent mis à jour." || err "Échec de la mise à jour (rc=$rc)."
      return $rc
      ;;
    *)
      err "Sous-commande inconnue : '${sub}'"
      echo -e "  Disponibles : ${CYAN}start  stop  status  version  detect  upgrade${RESET}"
      return 1
      ;;
  esac
}

