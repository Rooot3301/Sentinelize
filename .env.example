# ============================================================
# Configuration Sentinelize - SentinelOne Agent Manager v3.0
# ============================================================
# Copiez ce fichier en .env et adaptez les valeurs à votre environnement.
# Ce fichier est chargé automatiquement depuis :
#   - Le répertoire du script (deploy-s1.sh / sentinelonectl)
#   - /etc/sentinelize/.env
#   - /usr/local/etc/sentinelize/.env

# Chemin vers l'exécutable sentinelctl
S1CTL="/opt/sentinelone/bin/sentinelctl"

# Nom du service systemd
SERVICE_NAME="sentinelone"

# Nom du paquet de l'agent (RPM ou DEB selon votre OS)
# RPM : sentinelone-agent
# DEB : sentinelone-agent (généralement identique)
AGENT_PACKAGE="sentinelone-agent"

# Fichier de log du script
LOG_FILE="/var/log/s1-manager.log"

# Niveau de log : ERROR | WARN | INFO | DEBUG
LOG_LEVEL="INFO"
